{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routerctl.dev/schemas/device.schema.json",
  "title": "routerctl Device",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "routerctl.dev/v1alpha1"},
    "kind": {"const": "Device"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "spec": {
      "type": "object",
      "required": ["device", "backend", "transport"],
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "backend": {"enum": ["github", "oci", "native", "mock"]},
        "transport": {"enum": ["ssh", "https", "serial"]},
        "target": {"type": "string"},
        "github": {
          "type": "object",
          "properties": {
            "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
            "tag": {"type": "string"}
          }
        },
        "build": {
          "type": "object",
          "properties": {
            "profile": {"type": "string", "minLength": 1},
            "repository": {"type": "string", "minLength": 1},
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "output": {"type": "string", "minLength": 1}
          }
        },
        "artifact": {
          "type": "object",
          "properties": {
            "expected": {
              "type": "object",
              "properties": {
                "device": {"type": "string", "minLength": 1},
                "format": {"type": "string", "minLength": 1},
                "max_size_bytes": {"type": "integer", "minimum": 1},
                "board_id": {"type": "string"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"backend": {"const": "native"}}},
          "then": {
            "required": ["build", "artifact"],
            "properties": {
              "build": {"required": ["profile", "repository", "command", "output"]},
              "artifact": {"required": ["expected"], "properties": {"expected": {"required": ["device", "format", "max_size_bytes"]}}}
            }
          }
        }
      ]
    }
  }
}
