{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routerctl.dev/schemas/regulatory-label-bundle.schema.json",
  "title": "routerctl regulatory label bundle",
  "type": "object",
  "required": ["version", "generatedAt", "source", "artifacts"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": ["sha256", "layoutId"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "layoutId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "device_identity_crop"
              }
            },
            "required": ["role"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "giteki_mark_and_number_crop"
              }
            },
            "required": ["role"]
          }
        }
      ],
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["role", "file", "sha256"],
            "properties": {
              "role": {
                "const": "device_identity_crop"
              },
              "file": {
                "const": "device_identity_crop.png"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["role", "file", "sha256"],
            "properties": {
              "role": {
                "const": "giteki_mark_and_number_crop"
              },
              "file": {
                "const": "giteki_mark_and_number_crop.png"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "observations": {
      "type": "object",
      "properties": {
        "ocrCandidates": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "required": ["status", "certificationNumbers"],
              "properties": {
                "status": {
                  "const": "success"
                },
                "certificationNumbers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^\\d{3}-\\d{6}$"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["status", "error"],
              "properties": {
                "status": {
                  "const": "unavailable"
                },
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "no_match"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "not_run"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "reviewed": {
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "hardwareRevision": {
              "type": "string"
            },
            "certificationNumber": {
              "type": "string",
              "pattern": "^\\d{3}-\\d{6}$"
            },
            "status": {
              "enum": ["confirmed", "unreviewed"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
